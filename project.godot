; Minimal Godot project for developing and validating the addons/godot_dev_bridge addon
; in isolation. Not a game: it gives `--path .` a real project context so the addon's
; scripts resolve during headless checks, and it hosts the test fixtures.

config_version=5

[application]

config/name="Godot Dev Bridge (addon dev project)"
config/features=PackedStringArray("4.5")

[autoload]

DevBridge="*res://addons/godot_dev_bridge/dev_bridge.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_dev_bridge/plugin.cfg")
