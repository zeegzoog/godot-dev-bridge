# EditorConfig — https://editorconfig.org
# Universal formatter settings for any editor and any tech stack.

root = true

# ── Defaults (all files) ──────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
indent_style             = space
indent_size              = 4
trim_trailing_whitespace = true
insert_final_newline     = true

# ── Web / JavaScript / TypeScript ────────────────────────────────────────────
[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte}]
indent_size = 2

[*.{html,htm,css,scss,sass,less}]
indent_size = 2

# ── Data / Config formats ─────────────────────────────────────────────────────
[*.{json,jsonc,json5}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.xml]
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────────────────────
[*.{md,mdx}]
trim_trailing_whitespace = false   # trailing spaces = intentional line break
indent_size              = 2

# ── Shell scripts ─────────────────────────────────────────────────────────────
[*.sh]
end_of_line = lf

# ── Windows batch / PowerShell ────────────────────────────────────────────────
[*.{cmd,bat}]
end_of_line = crlf

[*.{ps1,psm1,psd1}]
end_of_line = crlf

# ── Go ────────────────────────────────────────────────────────────────────────
[*.go]
indent_style = tab
indent_size  = 4

# ── Python ───────────────────────────────────────────────────────────────────
[*.py]
indent_size = 4

# ── Rust ─────────────────────────────────────────────────────────────────────
[*.rs]
indent_size = 4

# ── C / C++ ──────────────────────────────────────────────────────────────────
[*.{c,h,cpp,hpp,cc,hh,cxx}]
indent_size = 4

# ── Java / Kotlin ─────────────────────────────────────────────────────────────
[*.{java,kt,kts}]
indent_size = 4

# ── Ruby ─────────────────────────────────────────────────────────────────────
[*.rb]
indent_size = 2

# ── PHP ───────────────────────────────────────────────────────────────────────
[*.php]
indent_size = 4

# ── Makefiles (tabs are required) ─────────────────────────────────────────────
[Makefile]
indent_style = tab

# ── Dockerfile ────────────────────────────────────────────────────────────────
[Dockerfile*]
indent_size = 4
