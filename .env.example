# Path to the primary Godot executable
# Windows: "C:\Program Files\Godot\Godot.exe"
# Linux: "/usr/bin/godot"
# macOS: "/Applications/Godot.app/Contents/MacOS/Godot"
GODOT_PATH=""

# Path to the Godot console wrapper (Windows) for synchronous log capturing
# Windows: "C:\Program Files\Godot\Godot_console.exe"
# Linux: "/usr/bin/godot_console"
# macOS: "/Applications/Godot.app/Contents/MacOS/Godot_console"
GODOT_CONSOLE_PATH=""
