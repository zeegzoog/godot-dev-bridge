# Rust build output
/target/
**/*.rs.bk

# Stray binaries: the client is built into /target/ and released by CI
*.exe
*.pdb
*.dll
*.so
*.dylib

# Godot editor cache. `*.import` and `*.uid` files are source: commit them
.godot/
export_presets.cfg

# Local environment (see .env.example)
.env*
!.env.example

# Release artifacts packed by hand (CI packs them in its own workspace)
/godot-dev-bridge-*.zip
/godot-dev-bridge-*.tar.gz
/release-notes.md

# Local working notes and references
.superpowers/
docs/superpowers/
.references/
scratch/

# Editors: settings.json holds machine paths; shared configs may be committed
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini
